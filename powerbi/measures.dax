// Current annual-plan KPIs. Create each definition as a separate Power BI measure.
// Count values are counts; ratios return fractions (format Percentage). Missing inputs remain BLANK.

// Postpartum acceptors are available; eligible postpartum population denominator must be supplied and confirmed.
Postpartum family planning acceptors =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), FILTER(ALL(Indicators), Indicators[Code] = "MAT_IPPCAR_Age")), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), FILTER(ALL(Indicators), Indicators[Code] = "MAT_IPPCAR_Age")))
VAR D = BLANK()
RETURN IF(ISBLANK(N) || ISBLANK(D) || D = 0, BLANK(), DIVIDE(N, D))

