// Comprehensive abortion care: Counts may cover different populations; not patient-level uptake.
Post-abortion FP service ratio =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAC.MA.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAC.MA.1"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAC.Tr.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAC.Tr.1"))
RETURN IF(ISBLANK(N) || ISBLANK(D) || D = 0, BLANK(), DIVIDE(N, D))

Post-abortion FP service ratio Input Review =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAC.MA.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAC.MA.1"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAC.Tr.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAC.Tr.1"))
VAR R = [Post-abortion FP service ratio]
RETURN SWITCH(TRUE(), ISBLANK(N) || ISBLANK(D), "Missing input", D = 0, "Zero denominator", N < 0 || D < 0 || R < 0 || R > 1, "Review data / period alignment", "Calculable; target not assessed")

