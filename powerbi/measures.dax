// Import-ready measure definitions: create each measure separately in Power BI.
// See README.md for the required model and percentage formatting.

// Family planning: New acceptors as a share of new and repeat acceptors.
New acceptor share =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Age.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Age.1"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Age"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Age"))
RETURN IF(ISBLANK(N) || ISBLANK(D) || D = 0, BLANK(), DIVIDE(N, D))

New acceptor share Input Review =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Age.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Age.1"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Age"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Age"))
VAR R = [New acceptor share]
RETURN SWITCH(TRUE(), ISBLANK(N) || ISBLANK(D), "Missing input", D = 0, "Zero denominator", N < 0 || D < 0 || R < 0 || R > 1, "Review data / period alignment", "Calculable; target not assessed")

// Family planning: Method mix; no universal preferred share.
Implant share among new acceptors =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Mtd.1.3"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Mtd.1.3"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Mtd.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Mtd.1"))
RETURN IF(ISBLANK(N) || ISBLANK(D) || D = 0, BLANK(), DIVIDE(N, D))

Implant share among new acceptors Input Review =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Mtd.1.3"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Mtd.1.3"))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MAT_CAR_Mtd.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MAT_CAR_Mtd.1"))
VAR R = [Implant share among new acceptors]
