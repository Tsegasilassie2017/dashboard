VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "MTCT_HEI_EID.1.1.1"), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "MTCT_HEI_EID.1.1.1"))
