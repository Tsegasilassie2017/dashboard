// EPI: (Dose 1 − dose 3) / dose 1. Period counts are not a linked cohort.
Pentavalent dose dropout proxy =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "EPI_DPT3.1."), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "EPI_DPT3.1."))
VAR D = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "EPI_DPT1.1."), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "EPI_DPT1.1."))
RETURN IF(ISBLANK(N) || ISBLANK(D) || D = 0, BLANK(), DIVIDE(D - N, D))

Pentavalent dose dropout proxy Input Review =
VAR N = IF(ISCROSSFILTERED(Facilities), CALCULATE(SUM(Observations[Value]), REMOVEFILTERS(Indicators), Observations[Code] = "EPI_DPT3.1."), CALCULATE(SUM(ReportedTotals[Value]), REMOVEFILTERS(Indicators), ReportedTotals[Code] = "EPI_DPT3.1."))
